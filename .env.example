# Server-Side Secrets (Cloudflare Pages Functions / Server Environment)
# NEVER prefix with VITE_ and NEVER commit actual secret values to Git!

# PBKDF2 Password Hash (Format: pbkdf2:600000:<saltHex>:<hashHex>)
# Generate using: node scripts/generate-password-hash.js "<password>"
ADMIN_PASSWORD_HASH=

# HMAC-SHA256 Secret for signing session cookies
SESSION_SECRET=
